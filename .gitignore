[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D Generated File On Crash Reports
sysinfo.txt

# Blender local backups
*.blend1
*.blend1.meta

# Local generated source assets
blendermodel/
GeneratedAssets/

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# VS Code
.vscode/
*.code-workspace

# Codex local config
.codex/

# JetBrains
.idea/
*.sln
*.csproj

# CCGS framework runtime artifacts (per-machine; not committed)
production/session-logs/
.claude/settings.local.json

# --- Unity auto-generated terrain upgrade artifact (junk) ---
Assets/_TerrainAutoUpgrade/
Assets/_TerrainAutoUpgrade.meta

# Note: large asset packs (Assets/Foliage Free, Assets/TreePackVol.1) are now
# tracked via Git LFS (binaries route to LFS via .gitattributes) — no longer ignored.

# --- Test output & Python caches ---
TestResults*.xml
**/__pycache__/
